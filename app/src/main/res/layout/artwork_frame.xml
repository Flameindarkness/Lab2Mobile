<?xml version="1.0" encoding="utf-8"?>
<!-- Рамка с изображением экспоната. Используется в портретной и альбомной разметке -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/frame_background"
    app:cardCornerRadius="@dimen/frame_corner_radius"
    app:cardElevation="@dimen/frame_elevation"
    app:contentPadding="@dimen/frame_padding"
    app:strokeColor="@color/frame_stroke"
    app:strokeWidth="@dimen/frame_stroke_width">

    <ImageView
        android:id="@+id/artwork_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />
</com.google.android.material.card.MaterialCardView>
